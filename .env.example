# Configuración del proveedor de IA de VyOps.
# Copiar este archivo como .env y completar la clave real.
# Nunca subir .env a GitHub.

GEMINI_API_KEY=tu_clave_aqui

# Directorio local de ChromaDB.
# Se genera durante la indexación y no debe subirse a Git.
VYOPS_VECTORSTORE_DIR=vectorstore_profesor

# Pausa entre lotes de embeddings durante la indexación.
# Valor en segundos. Predeterminado: 10.
# Se procesan hasta 10 fragmentos por lote, secuencialmente.
# Aumentar este valor si el proveedor limita las solicitudes.
VYOPS_EMBEDDING_PAUSA_SEGUNDOS=10
